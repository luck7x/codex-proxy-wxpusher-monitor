{
  "manifestVersion": 2,
  "name": "wxpusher-account-monitor",
  "displayName": "WxPusher 账号授权监控",
  "publisher": "luck7x",
  "version": "0.2.0",
  "description": "监控 OpenAI OAuth 账号凭据状态，并通过 WxPusher 推送授权失效与恢复通知",
  "license": "MIT",
  "author": "luck7x",
  "engines": {
    "codex-proxy-rs": ">=3.29.7, <4.0.0"
  },
  "main": "bin/plugin",
  "runtime": "trustedProcess",
  "contributes": {
    "maintenance": {}
  },
  "configurationSchema": {
    "type": "object",
    "required": ["appToken", "uid"],
    "properties": {
      "appToken": {
        "type": "string",
        "minLength": 10,
        "maxLength": 256,
        "title": "WxPusher SPT 或 AppToken"
      },
      "uid": {
        "type": "string",
        "minLength": 5,
        "maxLength": 256,
        "title": "标准推送接收 UID（SPT 模式不使用）"
      },
      "dailyProbeEnabled": {
        "type": "boolean",
        "default": true,
        "title": "启用每日无对话检测"
      },
      "sendStartupMessage": {
        "type": "boolean",
        "default": true,
        "title": "首次启用时发送测试消息"
      },
      "accountLabels": {
        "type": "object",
        "default": {},
        "title": "账号备注映射",
        "additionalProperties": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "additionalProperties": false
  },
  "secretFields": ["appToken"],
  "state": [
    {
      "namespace": "monitor",
      "schemaVersion": 1,
      "schema": {
        "type": "object",
        "required": ["initialized", "accounts"],
        "properties": {
          "initialized": { "type": "boolean" },
          "accounts": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "type": "object",
              "required": ["accountId", "state", "notifiedState", "lastProbeDay"],
              "properties": {
                "accountId": { "type": "string", "minLength": 1, "maxLength": 128 },
                "state": { "type": "string", "maxLength": 64 },
                "notifiedState": { "type": "string", "maxLength": 64 },
                "lastProbeDay": { "type": "integer", "minimum": -1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "maximumRecords": 1,
      "maximumBytes": 131072,
      "maximumValueBytes": 131072,
      "migratesFrom": []
    }
  ]
}

